# Supabase (safe to expose to client — restricted by RLS)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — SERVER-SIDE ONLY (Supabase Edge Function). Never put in Expo bundle.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI Whisper STT
OPENAI_API_KEY=sk-...

# ElevenLabs TTS
ELEVENLABS_API_KEY=...
EXPO_PUBLIC_ELEVENLABS_API_KEY=...
EXPO_PUBLIC_TTS_PROXY_URL=https://your-project.supabase.co/functions/v1/tts-proxy

# Proxy base URL for server-side Claude calls (Supabase Edge Function)
EXPO_PUBLIC_CLAUDE_PROXY_URL=https://your-project.supabase.co/functions/v1/claude-proxy
